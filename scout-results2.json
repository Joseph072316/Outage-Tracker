    "body": "\r\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <!-- Must stay first in <head>: without it the browser falls back to windows-1252 and\r\n         the UTF-8 accented characters in the translation strings render as mojibake. -->\r\n    <meta charset=\"utf-8\">\r\n    <!-- PHP-to-JS bootstrap values. Kept after <!DOCTYPE> and <meta charset>: printed before the\r\n         doctype it forced the page into quirks mode, which breaks zoom/reflow behaviour (WCAG 1.4.4/1.4.10).\r\n         // SECURITY REVIEW: verify before merging. Several values below come from $_POST and are echoed\r\n         into JS without JS-safe escaping (static, page, serviceIndex). Unchanged here; see the a11y plan. -->\r\n<script>\r\n    var mode = null;\r\n\r\n    if('' !== '') {\r\n        mode = JSON.parse('');\r\n    }\r\n\r\n    // var mode = JSON.parse('');\r\n    var client = 'walton';\r\n    var params_client = 'walton';\r\n    var serviceIndex = null;\r\n\tvar show_page = \"\";\r\n\tvar extAccountNo = \"\";\r\n\tvar admin = \"\";\r\n    var showStatic = false;\r\n    var dataUrl = \"\";\r\n\r\n    //}\r\n\r\n    var extAccountNo = '';\r\n\r\n\r\n    var admin = '';\r\n\r\n    var lookup_select = [];\r\n    var bounds;\r\n    var NorthEast;\r\n    var SouthWest;\r\n    var southWestMercBound;\r\n    var northEastMercBound;\r\n    var overlayLayer;\r\n</script>\r\n    <title>Outage App</title>\r\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\r\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"favicon-32x32.png\">\r\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"favicon-16x16.png\">\r\n<!--    <link href=\"css/Report.css\" rel=\"stylesheet\">-->\r\n    <link type=\"text/css\" href=\"css/Map.css?v=2.1.2\" rel=\"stylesheet\">\r\n    <!-- Roboto is self-hosted rather than loaded from fonts.googleapis.com, which would send\r\n         every visitor's IP to Google on page load. See fonts/roboto/README.md -->\r\n    <link type=\"text/css\" href=\"fonts/roboto/roboto.css\" rel=\"stylesheet\">\r\n    <link type=\"text/css\" href=\"/Common_Includes/vuetify/vuetify-v2.3.1/vuetify-v2.3.1.min.css\" rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"/Common_Includes/fontawesome-pro-5.8.2-web/css/all.css\">\r\n    <link rel=\"stylesheet\" href=\"fonts/css/dvicons.css\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"/Common_Includes/MapLibre/maplibre-gl.css\"/>\r\n    <!-- <link href=\"https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.css\" rel=\"stylesheet\" /> -->\r\n    <link type=\"text/css\" rel=\"stylesheet\" href=\"icons/css/dv-cfa-icons.css\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <!-- <meta http-equiv=\"Content-Security-Policy\" content=\"child-src blob: ; img-src data: blob: ; script-src 'self' 'unsafe-eval' 'unsafe-inline'  \" /> -->\r\n    <!-- <meta http-equiv=\"Content-Security-Policy\" content=\" connect-src 'self' https://maps.googleapis.com https://www.outageentry.com https://outageentry.com https://webtest.outageentry.com https://api.maptiler.com\"> -->\r\n\r\n    <style>\r\n        [v-cloak] > * { display:none }\r\n        [v-cloak]::before {\r\n            content: '';\r\n            position: absolute;\r\n            left: 50%;\r\n            top: 50%;\r\n            z-index: 1;\r\n            /*width: 150px;\r\n            height: 150px;*/\r\n            margin: -75px 0 0 -75px;\r\n            border: 16px solid #f3f3f3;\r\n            border-radius: 50%;\r\n            border-top: 16px solid darkgray;\r\n            width: 120px;\r\n            height: 120px;\r\n            -webkit-animation: spin 2s linear infinite;\r\n            animation: spin 2s linear infinite;\r\n        }\r\n        .loader{\r\n            content: '';\r\n            position: relative;\r\n            /*width: 46px;\r\n            height: 46px;*/\r\n            border: 4px solid #f3f3f3;\r\n            border-radius: 50%;\r\n            border-top: 4px solid darkgray;\r\n            width: 26px;\r\n            height: 26px;\r\n            -webkit-animation: spin 1s linear infinite;\r\n            animation: spin 1s linear infinite;\r\n        }\r\n        \r\n        /* Hide Vuetify's zero-width space from screen readers */\r\n        .v-select fieldset legend span {\r\n            position: absolute;\r\n            width: 1px;\r\n            height: 1px;\r\n            padding: 0;\r\n            margin: -1px;\r\n            overflow: hidden;\r\n            clip: rect(0, 0, 0, 0);\r\n            white-space: nowrap;\r\n            border-width: 0;\r\n        }\r\n        \r\n        /*\r\n         * Non-searchable v-selects render a readonly <input>, which browsers\r\n         * still give a blinking text caret on focus -- it looks like you can\r\n         * type into the dropdown when you can't. Hide the caret for plain\r\n         * selects only; autocomplete/combobox inputs really do accept typing.\r\n         */\r\n        .v-select:not(.v-autocomplete):not(.v-combobox) input[readonly] {\r\n            caret-color: transparent;\r\n            cursor: pointer;\r\n        }\r\n\r\n        /* Hide Vuetify's zero-width space in text fields from screen readers */\r\n        .v-text-field fieldset legend span,\r\n        .v-textarea fieldset legend span {\r\n            position: absolute;\r\n            width: 1px;\r\n            height: 1px;\r\n            padding: 0;\r\n            margin: -1px;\r\n            overflow: hidden;\r\n            clip: rect(0, 0, 0, 0);\r\n            white-space: nowrap;\r\n            border-width: 0;\r\n        }\r\n        \r\n        /*\r\n         * Shared focus indicator. Single source of truth -- add new focusable\r\n         * controls to this selector list rather than copying the declarations.\r\n         * The white inner ring keeps the indicator visible against the dark blue\r\n         * header bar as well as against white page backgrounds.\r\n         */\r\n        .custom-marker:focus,\r\n        .custom-image-marker:focus,\r\n        .dv-selector:focus,\r\n        .dv-selector:focus-visible,\r\n        .v-application a:focus-visible,\r\n        .v-application .v-btn:focus-visible,\r\n        .v-btn.v-btn--fab.v-size--small:focus,\r\n        .v-btn.v-btn--fab.v-size--small:focus-visible,\r\n        .danger-close-btn:focus-visible,\r\n        .small-search-button:focus-visible,\r\n        /* Vuetify sets outline:none on list items (dropdown options, menus,\r\n           recent searches) and leaves only a ~1.1:1 grey overlay. */\r\n        .v-application .v-list-item:focus-visible,\r\n        /* Radios/checkboxes: the focused element is a hidden native input, so\r\n           ring the visible control around it. */\r\n        .v-application .v-radio:focus-within,\r\n        .v-application .v-input--checkbox .v-input--selection-controls__input:focus-within,\r\n        /* Dropdowns and text fields without an outlined border (class=\"custom\")\r\n           have their focus underline removed in Map.css. */\r\n        .v-application .v-select.custom.v-input--is-focused .v-input__slot,\r\n        .v-application .dv-tab:focus-visible,\r\n        .v-application .dv-tab-active:focus-visible,\r\n        .maplibregl-ctrl button:focus-visible {\r\n            outline: 3px solid #4A90E2 !important;\r\n            outline-offset: 2px !important;\r\n            box-shadow: 0 0 0 1px #ffffff, 0 0 0 3px rgba(74, 144, 226, 0.4) !important;\r\n        }\r\n\r\n        /*\r\n         * Field boundaries and placeholder text. Vuetify's default\r\n         * rgba(0,0,0,.38) is ~2.7:1 on white, below the 3:1 needed for a\r\n         * field's border (WCAG 1.4.11) and the 4.5:1 for placeholder text\r\n         * (1.4.3). It's also why it's hard to see where you can type.\r\n         * rgba(0,0,0,.6) is ~5.7:1.\r\n         */\r\n        .v-application .v-text-field--outlined:not(.v-input--is-focused):not(.error--text) fieldset {\r\n            color: rgba(0, 0, 0, 0.6) !important;\r\n        }\r\n        .v-application input::placeholder,\r\n        .v-application textarea::placeholder {\r\n            color: rgba(0, 0, 0, 0.6) !important;\r\n            opacity: 1;\r\n        }\r\n\r\n        /*\r\n         * Respect the OS \"reduce motion\" setting (WCAG 2.3.3, and stops the\r\n         * infinitely pulsing marker for users who ask for that, 2.2.2).\r\n      "
